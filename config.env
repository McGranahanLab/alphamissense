#!/usr/bin/env bash
# Central configuration for AlphaMissense Apptainer workflow.
# Edit this file only; scripts consume all paths from here.

# -----------------------
# Runtime and local paths
# -----------------------
WORKFLOW_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN=python
MUTTABLE_TO_VCF_SCRIPT=${WORKFLOW_ROOT}/src/muttable_to_vcf.py
ANNOTATE_ALPHA_SCRIPT=${WORKFLOW_ROOT}/src/annotate_alpha_missense.py
SPLIT_MUTTABLE_SCRIPT=${WORKFLOW_ROOT}/src/split_muttable_by_tumour.py

# -----------------------
# Input and output locations (all local to this directory)
# -----------------------
# Path to  mutation table containing a `tumour_id` column.
MUTTABLE_TABLE=/nemo/project/proj-tracerx-lung/tctProjects/lungTx/Tx842/release/tracerx_842/tx842_mutation_table.tsv.gz

WORK_COHORT_NAME=tx842
WORK_ROOT=${WORKFLOW_ROOT}

# Derived workspace paths (do not usually need to edit)
WORK_INPUT_DIR=${WORK_ROOT}/input
WORK_OUTPUT_DIR=${WORK_ROOT}/output
WORK_ASSETS_DIR=${WORK_ROOT}/_assets

SPLIT_INPUT_DIR=${WORK_INPUT_DIR}/split_muttables/${WORK_COHORT_NAME}
VEP_INPUT_DIR=${WORK_INPUT_DIR}/vep/${WORK_COHORT_NAME}
VEP_OUTPUT_DIR=${WORK_OUTPUT_DIR}/vep/${WORK_COHORT_NAME}
ANNOTATED_OUTPUT_DIR=${WORK_OUTPUT_DIR}/annotated_muttables/${WORK_COHORT_NAME}

# -----------------------
# Apptainer / Singularity
# -----------------------
APPTAINER_BIN=singularity
APPTAINER_IMAGE=docker://ensemblorg/ensembl-vep

# Path to local image file if you prefer .sif workflow.
# Leave empty to run directly from docker:// URI.
APPTAINER_IMAGE_SIF=

# Container mount point corresponding to WORK_ROOT.
CONTAINER_WORKDIR=/data

# -----------------------
# AlphaMissense and VEP
# -----------------------
ALPHAMISSENSE_URL=https://storage.googleapis.com/dm_alphamissense/AlphaMissense_hg19.tsv.gz
ALPHAMISSENSE_FILE=${WORK_ASSETS_DIR}/AlphaMissense_hg19.tsv.gz

VEP_SPECIES=homo_sapiens
VEP_ASSEMBLY=GRCh37

# This must match the cache release expected by the image tag.
VEP_CACHE_VERSION=115

# -----------------------
# Workflow behavior
# -----------------------
TUMOUR_GLOB=*
OVERWRITE_EXISTING=false

# Compression for split per-tumour muttables.
# true writes *.tsv.gz, false writes *.tsv
SPLIT_COMPRESS_GZIP=true
